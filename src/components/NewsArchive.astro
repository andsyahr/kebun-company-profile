---
import { dateLocales, type Lang } from '../i18n/ui';
import { NEWS_PAGE_SIZE, type NewsArchiveText } from '../i18n/newsArchive';
import type { NewsPost } from '../lib/news';
import BridgeArc from './BridgeArc.astro';

interface Props {
  lang: Lang;
  posts: NewsPost[];
  page: number;
  t: NewsArchiveText;
}

const { lang, posts, page, t } = Astro.props;

const totalPages = Math.max(1, Math.ceil(posts.length / NEWS_PAGE_SIZE));
const start = (page - 1) * NEWS_PAGE_SIZE;
const visible = posts.slice(start, start + NEWS_PAGE_SIZE);

// Halaman 1 = /news/ (URL kanonik tanpa prefix /page/), halaman lain = /news/page/N/
const hrefFor = (n: number) =>
  n <= 1 ? `/${lang}/news/#daftar` : `/${lang}/news/page/${n}/#daftar`;

// Nomor halaman untuk desktop: semua jika <= 7, jika lebih pakai elipsis di sekitar halaman aktif
const pageNumbers: (number | '…')[] = (() => {
  if (totalPages <= 7) return Array.from({ length: totalPages }, (_, i) => i + 1);
  const picked = [...new Set([1, totalPages, page - 1, page, page + 1])]
    .filter((n) => n >= 1 && n <= totalPages)
    .sort((a, b) => a - b);
  const out: (number | '…')[] = [];
  picked.forEach((n, i) => {
    if (i > 0 && n - (picked[i - 1] as number) > 1) out.push('…');
    out.push(n);
  });
  return out;
})();

const btnBase =
  'inline-flex h-11 min-w-11 items-center justify-center rounded-lg border px-3 text-sm font-bold transition-colors';
const btnIdle = `${btnBase} border-washi-300 bg-white text-ink-700 hover:bg-washi-100`;
const btnDisabled = `${btnBase} cursor-default border-washi-200 bg-washi-50 text-ink-300`;
const btnCurrent = `${btnBase} border-garden-900 bg-garden-900 text-white`;
---

<section class="bg-washi-50">
  <div class="container-site py-14 lg:py-16">
    <h1 class="text-center text-3xl font-extrabold text-garden-900 sm:text-4xl">{t.title}</h1>
    <BridgeArc variant="divider" class="mt-3" />
    <p class="mx-auto mt-3 max-w-xl text-center leading-relaxed text-ink-600">{t.lead}</p>
  </div>
</section>

<section id="daftar" class="bg-white scroll-mt-20">
  <div class="container-site py-14 lg:py-18">
    {
      visible.length === 0 ? (
        <p class="text-center text-ink-600">{t.empty}</p>
      ) : (
        <div class="mx-auto max-w-3xl space-y-4">
          {visible.map((post) => (
            <a href={`/${lang}/news/${post.slug}/`} class="group card block transition-shadow hover:shadow-md">
              <div class="flex flex-wrap items-center gap-3">
                <time datetime={post.publishedAt.toISOString()} class="text-xs font-semibold text-ink-400">
                  {post.publishedAt.toLocaleDateString(dateLocales[lang], { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <span class="rounded-full bg-garden-100 px-2.5 py-0.5 text-[11px] font-bold text-garden-800">
                  {t.categories[post.category]}
                </span>
              </div>
              <h2 class="mt-2 text-lg font-bold leading-snug text-ink-900 group-hover:text-garden-700">{post.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{post.description}</p>
            </a>
          ))}
        </div>
      )
    }

    {
      totalPages > 1 && (
        <nav class="mx-auto mt-10 flex max-w-3xl flex-col items-center gap-4" aria-label={t.pager.aria}>
          <p class="text-center text-xs font-semibold text-ink-500">
            {t.pager.info(posts.length, page, totalPages)}
          </p>

          {/* Mobile: prev / indikator / next — tombol besar, hanya 3 kontrol */}
          <div class="flex w-full items-center justify-between gap-3 sm:hidden">
            {page > 1 ? (
              <a href={hrefFor(page - 1)} class={btnIdle} aria-label={t.pager.prev}>
                ‹ {t.pager.prev}
              </a>
            ) : (
              <span class={btnDisabled} aria-disabled="true">
                ‹ {t.pager.prev}
              </span>
            )}
            <span class="text-sm font-bold text-garden-900">
              {page} / {totalPages}
            </span>
            {page < totalPages ? (
              <a href={hrefFor(page + 1)} class={btnIdle} aria-label={t.pager.next}>
                {t.pager.next} ›
              </a>
            ) : (
              <span class={btnDisabled} aria-disabled="true">
                {t.pager.next} ›
              </span>
            )}
          </div>

          {/* Desktop: nomor halaman + prev/next */}
          <div class="hidden items-center gap-1.5 sm:flex">
            {page > 1 ? (
              <a href={hrefFor(page - 1)} class={`${btnIdle} mr-1`} aria-label={t.pager.prev}>
                ‹
              </a>
            ) : (
              <span class={`${btnDisabled} mr-1`} aria-disabled="true">
                ‹
              </span>
            )}
            {pageNumbers.map((n) =>
              n === '…' ? (
                <span class="px-1 text-ink-400">…</span>
              ) : n === page ? (
                <span class={btnCurrent} aria-current="page">
                  {n}
                </span>
              ) : (
                <a href={hrefFor(n)} class={btnIdle}>
                  {n}
                </a>
              )
            )}
            {page < totalPages ? (
              <a href={hrefFor(page + 1)} class={`${btnIdle} ml-1`} aria-label={t.pager.next}>
                ›
              </a>
            ) : (
              <span class={`${btnDisabled} ml-1`} aria-disabled="true">
                ›
              </span>
            )}
          </div>
        </nav>
      )
    }
  </div>
</section>
