---
/**
 * Signature element situs: "bridge arc" — jalur lengkung putus-putus
 * yang menghubungkan node ID (hijau garden) dan JP (merah torii).
 * variant "hero"    → besar, dengan label ID/JP, animasi dash halus
 * variant "divider" → kecil, dipakai sebagai pemisah section
 */
interface Props {
  variant?: 'hero' | 'divider';
  class?: string;
}
const { variant = 'divider', class: className = '' } = Astro.props;
---

{
  variant === 'hero' ? (
    <svg
      class={className}
      viewBox="0 0 800 190"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <defs>
        <radialGradient id="sphere-id" cx="35%" cy="30%" r="90%">
          <stop offset="0%" stop-color="var(--color-garden-300)" />
          <stop offset="100%" stop-color="var(--color-garden-700)" />
        </radialGradient>
        <radialGradient id="sphere-jp" cx="35%" cy="30%" r="90%">
          <stop offset="0%" stop-color="var(--color-torii-100)" />
          <stop offset="100%" stop-color="var(--color-torii-600)" />
        </radialGradient>
      </defs>
      <path
        class="bridge-dash"
        d="M 60 160 C 250 20, 550 20, 740 160"
        stroke="var(--color-garden-500)"
        stroke-width="3"
        stroke-linecap="round"
        stroke-dasharray="2 14"
        stroke-opacity="0.6"
      />
      <ellipse cx="60" cy="178" rx="16" ry="4" fill="var(--color-garden-900)" opacity="0.15" />
      <ellipse cx="740" cy="178" rx="16" ry="4" fill="var(--color-garden-900)" opacity="0.15" />
      <circle cx="60" cy="160" r="11" fill="url(#sphere-id)" />
      <circle cx="740" cy="160" r="11" fill="url(#sphere-jp)" />
      <text
        x="60"
        y="186"
        text-anchor="middle"
        font-size="15"
        font-weight="700"
        fill="var(--color-garden-700)"
        font-family="var(--font-display)"
      >
        ID
      </text>
      <text
        x="740"
        y="186"
        text-anchor="middle"
        font-size="15"
        font-weight="700"
        fill="var(--color-torii-600)"
        font-family="var(--font-display)"
      >
        JP
      </text>
    </svg>
  ) : (
    <div class={`flex justify-center py-2 ${className}`} aria-hidden="true">
      <svg viewBox="0 0 220 44" width="220" height="44" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M 18 34 C 70 4, 150 4, 202 34"
          stroke="var(--color-garden-300)"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-dasharray="1 10"
        />
        <circle cx="18" cy="34" r="5" fill="var(--color-garden-500)" />
        <circle cx="202" cy="34" r="5" fill="var(--color-torii-500)" />
      </svg>
    </div>
  )
}
