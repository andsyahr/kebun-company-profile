---
import { Image } from 'astro:assets';
import logoKti from '../assets/kebuntech.png';
import { LANGS, useUI, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useUI(lang);

const navItems = [
  { href: `/${lang}/company/`, label: t.nav.company },
  { href: `/${lang}/services/`, label: t.nav.services },
  { href: `/${lang}/for-companies/`, label: t.nav.forCompanies },
  { href: `/${lang}/for-candidates/`, label: t.nav.forCandidates },
  { href: `/${lang}/training/`, label: t.nav.training },
  { href: `/${lang}/news/`, label: t.nav.news },
];

// Language switcher: pertahankan path halaman saat ganti bahasa
const currentPath = Astro.url.pathname.replace(/^\/(ja|id|en)/, '') || '/';

const headerCtaHref =
  lang === 'id' ? `/id/for-candidates/#daftar` : `/${lang}/contact/`;
---

<header class="sticky top-0 z-40 border-b border-washi-200 bg-washi-50/95 backdrop-blur">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a href={`/${lang}/`} class="flex shrink-0 items-center" aria-label={t.siteName}>
      <Image src={logoKti} alt="PT Kebun Teknologi Indonesia" class="h-10 w-auto sm:h-11" densities={[1, 2]} />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-2.5 py-2 text-[13px] font-medium text-ink-700 transition-colors hover:bg-garden-50 hover:text-garden-900"
            aria-current={Astro.url.pathname.startsWith(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <div class="flex items-center rounded-lg border border-washi-200 bg-white p-0.5" role="group" aria-label={t.misc.langSwitch}>
        {
          LANGS.map((l) => (
            <a
              href={`/${l}${currentPath}`}
              class:list={[
                'rounded-md px-2 py-1 text-xs font-semibold transition-colors',
                l === lang
                  ? 'bg-garden-900 text-white'
                  : 'text-ink-600 hover:bg-garden-50 hover:text-garden-900',
              ]}
              aria-current={l === lang ? 'true' : undefined}
              lang={l}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>

      <a href={headerCtaHref} class="btn-primary hidden !px-4 !py-2 text-sm md:inline-flex">
        {t.cta.header}
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-washi-200 bg-white text-ink-700 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.misc.menuOpen}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="menu-open-icon" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="menu-close-icon hidden" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-washi-200 bg-washi-50 lg:hidden">
    <nav class="container-site flex flex-col gap-1 py-4" aria-label="Mobile">
      {
        navItems.map((item) => (
          <a href={item.href} class="rounded-lg px-3 py-2.5 text-sm font-medium text-ink-700 hover:bg-garden-50 hover:text-garden-900">
            {item.label}
          </a>
        ))
      }
      <a href={headerCtaHref} class="btn-primary mt-2 text-sm">{t.cta.header}</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu?.classList.toggle('hidden', isOpen);
    toggle.querySelector('.menu-open-icon')?.classList.toggle('hidden', !isOpen);
    toggle.querySelector('.menu-close-icon')?.classList.toggle('hidden', isOpen);
  });
</script>
