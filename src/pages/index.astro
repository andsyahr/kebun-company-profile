---
// Root "/" → redirect server-side (302) berdasarkan Accept-Language, default /ja/ (= x-default).
// SSR: prerender = false agar bisa membaca header request; tidak ada HTML → tidak ada noindex.
export const prerender = false;

const accept = Astro.request.headers.get('accept-language') ?? '';
const first = accept.split(',')[0]?.trim().toLowerCase() ?? '';
const lang = first.startsWith('id') ? 'id' : first.startsWith('en') ? 'en' : 'ja';

return new Response(null, {
  status: 302,
  headers: {
    Location: `/${lang}/`,
    Vary: 'Accept-Language',
    'Cache-Control': 'no-store',
  },
});
---
