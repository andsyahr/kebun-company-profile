---
import { marked } from 'marked';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { dateLocales, useUI, isLang, type Lang } from '../../../i18n/ui';
import { getNewsBySlug } from '../../../lib/news';

export const prerender = false;

const langParam = Astro.params.lang;
if (!isLang(langParam)) return Astro.redirect('/id/news/');
const lang = langParam as Lang;
const slug = Astro.params.slug!;
const ui = useUI(lang);

const post = await getNewsBySlug(lang, slug);
if (!post) return Astro.redirect(`/${lang}/news/`);

// Artikel lama = markdown, artikel baru = HTML dari CKEditor.
// marked meneruskan blok HTML apa adanya → keduanya aman lewat satu jalur.
const bodyHtml = await marked.parse(post.body, { async: true });

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  datePublished: post.publishedAt.toISOString(),
  inLanguage: lang,
  author: { '@type': 'Organization', name: 'PT Kebun Teknologi Indonesia' },
  publisher: { '@type': 'Organization', name: 'PT Kebun Teknologi Indonesia', url: 'https://kebun.tech' },
};
---

<BaseLayout
  lang={lang}
  title={post.title}
  description={post.description}
  path={`/news/${slug}/`}
  ogType="article"
  publishedTime={post.publishedAt.toISOString()}
  extraJsonLd={[articleJsonLd]}
>
  <article class="bg-white">
    <div class="container-site max-w-3xl py-14 lg:py-16">
      <a href={`/${lang}/news/`} class="inline-flex items-center gap-1.5 text-sm font-semibold text-garden-700 hover:text-garden-900">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6"/></svg>
        {ui.misc.backToNews}
      </a>
      <h1 class="mt-6 text-2xl font-extrabold leading-snug text-garden-900 sm:text-3xl">{post.title}</h1>
      <p class="mt-3 text-sm text-ink-400">
        {ui.misc.publishedOn}:
        <time datetime={post.publishedAt.toISOString()}>
          {post.publishedAt.toLocaleDateString(dateLocales[lang], { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </p>
      <hr class="mt-6 border-washi-200" />
      <div class="prose-basic mt-8" set:html={bodyHtml} />
    </div>
  </article>
</BaseLayout>
