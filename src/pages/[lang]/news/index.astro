---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BridgeArc from '../../../components/BridgeArc.astro';
import { dateLocales, isLang, type Lang } from '../../../i18n/ui';
import { listPublishedNews } from '../../../lib/news';

export const prerender = false;

const langParam = Astro.params.lang;
if (!isLang(langParam)) return Astro.redirect('/id/news/');
const lang = langParam as Lang;

const t = {
  ja: {
    meta: { title: 'ニュース・コラム', description: 'PT Kebun Teknologi Indonesiaからのお知らせと、特定技能・育成就労・インドネシア人材に関するコラムをお届けします。' },
    title: 'ニュース・コラム',
    lead: '制度の最新情報から現場のノウハウまで、日イ人材の「いま」を発信します。',
    empty: '記事はまだありません。',
    categories: { news: 'ニュース', column: 'コラム', update: 'お知らせ' },
  },
  id: {
    meta: { title: 'Berita & Artikel', description: 'Berita terbaru dan artikel seputar kerja di Jepang: program SSW, Ikusei Shuro, tips persiapan, dan info dari PT Kebun Teknologi Indonesia.' },
    title: 'Berita & Artikel',
    lead: 'Info terbaru seputar kerja di Jepang — regulasi, tips, dan kabar dari Kebun.',
    empty: 'Belum ada artikel.',
    categories: { news: 'Berita', column: 'Artikel', update: 'Info' },
  },
  en: {
    meta: { title: 'News & Articles', description: 'News and articles from PT Kebun Teknologi Indonesia on SSW, Ikusei Shuro and Indonesian talent for Japan.' },
    title: 'News & Articles',
    lead: 'Updates on regulations, practical know-how, and news from Kebun.',
    empty: 'No articles yet.',
    categories: { news: 'News', column: 'Column', update: 'Update' },
  },
}[lang];

const posts = await listPublishedNews(lang);
---

<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description} path="/news/">
  <section class="bg-washi-50">
    <div class="container-site py-14 lg:py-16">
      <h1 class="text-center text-3xl font-extrabold text-garden-900 sm:text-4xl">{t.title}</h1>
      <BridgeArc variant="divider" class="mt-3" />
      <p class="mx-auto mt-3 max-w-xl text-center leading-relaxed text-ink-600">{t.lead}</p>
    </div>
  </section>

  <section class="bg-white">
    <div class="container-site py-14 lg:py-18">
      {
        posts.length === 0 ? (
          <p class="text-center text-ink-600">{t.empty}</p>
        ) : (
          <div class="mx-auto max-w-3xl space-y-4">
            {posts.map((post) => (
              <a href={`/${lang}/news/${post.slug}/`} class="group card block transition-shadow hover:shadow-md">
                <div class="flex flex-wrap items-center gap-3">
                  <time datetime={post.publishedAt.toISOString()} class="text-xs font-semibold text-ink-400">
                    {post.publishedAt.toLocaleDateString(dateLocales[lang], { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  <span class="rounded-full bg-garden-100 px-2.5 py-0.5 text-[11px] font-bold text-garden-800">
                    {t.categories[post.category]}
                  </span>
                </div>
                <h2 class="mt-2 text-lg font-bold leading-snug text-ink-900 group-hover:text-garden-700">{post.title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-ink-600">{post.description}</p>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
