---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NewsArchive from '../../../components/NewsArchive.astro';
import { isLang, type Lang } from '../../../i18n/ui';
import { newsArchiveT } from '../../../i18n/newsArchive';
import { listPublishedNews } from '../../../lib/news';

export const prerender = false;

const langParam = Astro.params.lang;
if (!isLang(langParam)) return Astro.redirect('/id/news/');
const lang = langParam as Lang;
const t = newsArchiveT[lang];

// URL lama berbasis query (?page=N) → path kanonik /news/page/N/ agar tidak duplikat
const qPage = Astro.url.searchParams.get('page');
if (qPage !== null) {
  const n = Number(qPage);
  if (Number.isInteger(n) && n > 1) return Astro.redirect(`/${lang}/news/page/${n}/`, 301);
  return Astro.redirect(`/${lang}/news/`, 301);
}

const posts = await listPublishedNews(lang);
---

<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description} path="/news/">
  <NewsArchive lang={lang} posts={posts} page={1} t={t} />
</BaseLayout>
