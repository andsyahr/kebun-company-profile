---
import '@fontsource-variable/noto-sans-jp';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LANGS, ogLocales, useUI, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path setelah prefix bahasa, mis. "/company/" — dipakai untuk canonical & hreflang */
  path: string;
  /** JSON-LD tambahan selain Organization (mis. LocalBusiness di halaman kontak) */
  extraJsonLd?: Record<string, unknown>[];
  /** og:type — "article" untuk halaman berita */
  ogType?: string;
  /** ISO date — memicu meta article:published_time */
  publishedTime?: string;
}

const { lang, title, description, path, extraJsonLd = [], ogType = 'website', publishedTime } = Astro.props;
const t = useUI(lang);

const site = 'https://kebun.tech';
const canonical = `${site}/${lang}${path}`;
const fullTitle = title.includes('Kebun') ? title : `${title} | ${t.siteName}`;

// JSON-LD Organization — dipasang di semua halaman
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'PT Kebun Teknologi Indonesia',
  url: site,
  logo: `${site}/og-image.png`,
  description: t.footer.description,
  email: 'business@kebun.tech',
  memberOf: {
    '@type': 'Organization',
    name: '株式会社ANCジャパン (ANC Japan Co., Ltd.)',
    url: 'https://anc-japan.com',
  },
};

const jsonLdBlocks = [organizationJsonLd, ...extraJsonLd];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    {/* hreflang alternates untuk semua bahasa + x-default → ja */}
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={`${site}/${l}${path}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${site}/ja${path}`} />

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={ogLocales[l]} />
    ))}
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-garden-900 focus:px-4 focus:py-2 focus:text-white"
    >
      {lang === 'ja' ? '本文へスキップ' : lang === 'id' ? 'Lompat ke konten' : 'Skip to content'}
    </a>
    <Header lang={lang} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
