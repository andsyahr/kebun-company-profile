rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /news/{id} {
      // Publik hanya boleh baca artikel yang sudah terbit; admin login bisa baca semua (draft dsb.)
      allow read: if resource.data.published == true || request.auth != null;
      // Tulis hanya user terautentikasi (admin dibuat manual di Firebase Console).
      // Lebih ketat: kunci ke UID admin — allow write: if request.auth != null && request.auth.uid == 'UID_ADMIN';
      allow write: if request.auth != null;
    }
  }
}
